# Copy to .env for local development. Never commit a real .env.
# In production these live in /etc/missionzero-proxy/env (see info/DEPLOYMENT.md).

# development | production | test
NODE_ENV=development

# Listen address. Production must stay on loopback, behind Nginx.
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info

# live = call the iBot4CRMs middleware. mock = serve the files in fixtures/.
# mock is refused when NODE_ENV=production.
MIDDLEWARE_MODE=mock

# The MissionZero application token (live mode). Set exactly one of the two.
# Prefer the file in production: a file readable only by the service user.
MIDDLEWARE_TOKEN=
MIDDLEWARE_TOKEN_FILE=

# Comma-separated browser origins allowed by CORS. Production: https only.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Optional tuning (defaults shown).
# CACHE_TTL_SECONDS=15
# CACHE_STALE_MAX_SECONDS=600
# UPSTREAM_TIMEOUT_MS=8000
# UPSTREAM_MAX_BYTES=5242880
# RATE_LIMIT_PER_MINUTE=300

# Only if the middleware certificate is signed by a private CA: a PEM bundle that
# Node trusts IN ADDITION to the public CAs. Read by Node itself at start-up.
# NODE_EXTRA_CA_CERTS=/etc/missionzero-proxy/upstream-ca.pem
